# Google Gemini key (https://aistudio.google.com/apikey). Powers conversations and the natural voice.
# Without it, tasks, habits, goals, people, check-ins and the 3D companion still work.
GEMINI_API_KEY=

# Database for accounts and everyone's data.
# On Vercel: Storage → Upstash (Redis) → connect to the project; these are filled in for you.
# Locally you can leave them empty: data is kept in ./data instead.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# Optional
# AUTH_SECRET=                      # signs session cookies; generated and stored in the database if unset
# MOCHI_CHAT_LIMIT_PER_HOUR=60      # messages per person per hour
# MOCHI_TTS_LIMIT_PER_HOUR=300      # natural-voice clips per person per hour
# GEMINI_MODEL=gemini-3.5-flash     # tried first; falls back automatically when busy or out of quota
# GEMINI_THINKING=MINIMAL           # MINIMAL = fastest replies; LOW / HIGH = deeper advice, slower
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# MOCHI_DATA_DIR=./data             # local development only
# MOCHI_DEBUG=1                     # log which model answered and how long each step took
